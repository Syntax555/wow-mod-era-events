[worldserver]

########################################
# mod-era-events
########################################
#
#    Timed live world events for mod-individual-progression. Each event belongs to one era
#    (IP progression tier): only characters at that tier see it, and a scheduled event only starts
#    when enough real players at that tier are online.
#

#
#    EraEvents.Enable
#        Description: Master switch.
#        Default:     1
#

EraEvents.Enable = 1

#
#    EraEvents.MinRealPlayers
#        Description: Real players (not playerbots, not GMs) at an event's tier who must be online
#                     for a scheduled event to start. Playerbots at the tier still join in.
#        Default:     2
#

EraEvents.MinRealPlayers = 2

#
#    EraEvents.RetryMinutes
#        Description: While an event is due but too few players are online, how often it checks again.
#        Default:     5
#

EraEvents.RetryMinutes = 5

########################################
# Per event
########################################
#
#    Every event takes the same settings, after its name:
#
#    EraEvents.<Event>.Enable            1 to schedule it, 0 to never run it (GMs can't start it either).
#    EraEvents.<Event>.IntervalMin       Minutes between one event and the next chance of another,
#    EraEvents.<Event>.IntervalMax       picked at random between the two.
#    EraEvents.<Event>.WarningMinutes    Notice the players of that era get before it starts. 0 = none.
#    EraEvents.<Event>.DurationMinutes   How long the players have before the event gives up.
#    EraEvents.<Event>.RewardGold        Gold for everyone taking part when it's won.
#    EraEvents.<Event>.RewardFaction     Faction id for the reputation reward, 0 for none.
#    EraEvents.<Event>.RewardReputation  Reputation for that faction.
#    EraEvents.<Event>.RewardItem        Item id handed out as well, 0 for none. Sent by mail when bags are full.
#    EraEvents.<Event>.RewardItemCount   How many of that item.
#

#
#    Gates of Ahn'Qiraj (tier 4: the gong has been rung, the war isn't won yet)
#        Waves of Qiraji storm out of the Scarab Wall against a Kaldorei line; the flashback's
#        dragons join in, then Lieutenant General Nokhor. Rewards Cenarion Circle reputation.
#
#    EraEvents.AQWar.RealmWideMinutes
#        The Ahn'Qiraj War. The moment anyone completes Bang a Gong! the event runs for this
#        many minutes for the whole realm, with no notice and no minimum number of players:
#          - everyone online is told who rang the gong;
#          - whoever is in Silithus is in the battle at the Scarab Wall, whatever their era;
#          - each time Nokhor falls, everyone there gets the reward, and after five minutes the
#            swarm comes again, until the time is up;
#          - everyone sees mod-individual-progression's own war as a character of that era does:
#            the three Colossi and the crystal camps in Silithus and Darkshore.
#        A second gong while it runs starts the time over. 0 = the gong starts a plain run for
#        its era instead, DurationMinutes long.
#        Default: 120
#

EraEvents.AQWar.Enable = 1
EraEvents.AQWar.IntervalMin = 120
EraEvents.AQWar.IntervalMax = 240
EraEvents.AQWar.WarningMinutes = 10
EraEvents.AQWar.DurationMinutes = 45
EraEvents.AQWar.RealmWideMinutes = 120
EraEvents.AQWar.RewardGold = 20
EraEvents.AQWar.RewardFaction = 609
EraEvents.AQWar.RewardReputation = 250
EraEvents.AQWar.RewardItem = 0
EraEvents.AQWar.RewardItemCount = 0

#
#    Scourge Invasion (tier 6: after Ahn'Qiraj, before Naxxramas)
#        Takes turns between an abomination loose in Stormwind or Undercity and a necropolis surge
#        in one of the six invasion zones. Rewards Argent Dawn reputation and Necrotic Runes.
#

EraEvents.ScourgeInvasion.Enable = 1
EraEvents.ScourgeInvasion.IntervalMin = 120
EraEvents.ScourgeInvasion.IntervalMax = 240
EraEvents.ScourgeInvasion.WarningMinutes = 10
EraEvents.ScourgeInvasion.DurationMinutes = 30
EraEvents.ScourgeInvasion.RewardGold = 15
EraEvents.ScourgeInvasion.RewardFaction = 529
EraEvents.ScourgeInvasion.RewardReputation = 250
EraEvents.ScourgeInvasion.RewardItem = 22484
EraEvents.ScourgeInvasion.RewardItemCount = 5

#
#    Legion Incursion (tier 7: after Naxxramas, before the Dark Portal opens)
#        A fel portal opens outside Gadgetzan, Everlook, Cenarion Hold, Nethergarde Keep or Light's
#        Hope Chapel and demons march on the town, led by a Dreadlord and finally a Pit Commander.
#        Rewards Argent Dawn reputation.
#

EraEvents.LegionIncursion.Enable = 1
EraEvents.LegionIncursion.IntervalMin = 120
EraEvents.LegionIncursion.IntervalMax = 240
EraEvents.LegionIncursion.WarningMinutes = 10
EraEvents.LegionIncursion.DurationMinutes = 30
EraEvents.LegionIncursion.RewardGold = 20
EraEvents.LegionIncursion.RewardFaction = 529
EraEvents.LegionIncursion.RewardReputation = 150
EraEvents.LegionIncursion.RewardItem = 0
EraEvents.LegionIncursion.RewardItemCount = 0

#
#    Zombie Infestation (tier 12: the end of the Burning Crusade, before Northrend)
#        The 3.0.2 plague in Stormwind or Orgrimmar. Zombies infect; Argent Healers cure; the
#        infected who aren't cured in time turn into zombies for three minutes. Smash the plagued
#        grain crates and kill the dead to win. Rewards Argent Dawn reputation.
#

EraEvents.ZombieInfestation.Enable = 1
EraEvents.ZombieInfestation.IntervalMin = 120
EraEvents.ZombieInfestation.IntervalMax = 240
EraEvents.ZombieInfestation.WarningMinutes = 10
EraEvents.ZombieInfestation.DurationMinutes = 30
EraEvents.ZombieInfestation.RewardGold = 50
EraEvents.ZombieInfestation.RewardFaction = 529
EraEvents.ZombieInfestation.RewardReputation = 250
EraEvents.ZombieInfestation.RewardItem = 0
EraEvents.ZombieInfestation.RewardItemCount = 0
